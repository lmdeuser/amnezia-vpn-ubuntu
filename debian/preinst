#!/bin/sh
set -e

is_run_install() {
    [ -d /opt/AmneziaVPN ] \
        && [ -f /opt/AmneziaVPN/post_uninstall.sh ] \
        && ! dpkg-query -S /opt/AmneziaVPN/bin/AmneziaVPN >/dev/null 2>&1
}

migrate_user_settings() {
    user=$1
    home=$2
    [ ! -L "$home" ] && [ -d "$home" ] || return 0
    org="$home/.config/AmneziaVPN.ORG"
    [ ! -L "$org" ] && [ -d "$org" ] || return 0

    helper='
org=$1
[ ! -L "$org" ] && [ -d "$org" ] || exit 0
backup_dir=$(mktemp -d "$org/run-migration-backup-$(date +%Y%m%d%H%M%S).XXXXXX")
primary_config="$org/AmneziaVPN.conf"
nested_dir="$org/AmneziaVPN"
nested_config="$nested_dir/AmneziaVPN.conf"
if [ ! -L "$primary_config" ] && [ -f "$primary_config" ]; then
    cp -p "$primary_config" "$backup_dir/AmneziaVPN.conf"
fi
if [ ! -L "$nested_dir" ] && [ -d "$nested_dir" ] && [ ! -L "$nested_config" ] && [ -f "$nested_config" ]; then
    cp -p "$nested_config" "$backup_dir/nested-AmneziaVPN.conf"
    if [ ! -e "$primary_config" ] && [ ! -L "$primary_config" ]; then
        cp -p "$nested_config" "$primary_config"
    fi
fi
'
    if [ "$user" = root ]; then
        sh -e -c "$helper" _ "$org"
    else
        runuser -u "$user" -- sh -e -c "$helper" _ "$org" || true
    fi
}

if [ "$1" = install ] || [ "$1" = upgrade ]; then
    if is_run_install; then
        getent passwd | while IFS=: read -r user _ uid _ _ home _; do
            case "$uid" in
                ''|*[!0-9]*) continue ;;
            esac
            if { [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ]; } || [ "$user" = root ]; then
                migrate_user_settings "$user" "$home"
            fi
        done

        install -d -m 700 /var/lib/amneziavpn/run-migration
        if [ -f /etc/systemd/system/AmneziaVPN.service ]; then
            cp -a /etc/systemd/system/AmneziaVPN.service \
                /var/lib/amneziavpn/run-migration/AmneziaVPN.service
        fi

        if [ -d /run/systemd/system ]; then
            if systemctl is-active --quiet AmneziaVPN.service; then
                systemctl stop AmneziaVPN.service
            fi
            systemctl disable AmneziaVPN.service >/dev/null 2>&1 || true
        fi
        pkill -TERM -x AmneziaVPN >/dev/null 2>&1 || true
        rm -f /etc/systemd/system/AmneziaVPN.service
        rm -rf /opt/AmneziaVPN
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
        fi
    fi
fi

#DEBHELPER#
